# Copy to .env and fill in. NEVER commit .env.

# --- PostgreSQL (used by docker-compose and the backend) ---
DB_NAME=aquaflow
DB_USERNAME=aquaflow
DB_PASSWORD=change-me-locally
# Host port for PostgreSQL. Use 5433 if a local PostgreSQL already uses 5432 (common on Windows).
DB_PORT=5432
# The port in this URL must match DB_PORT.
DB_URL=jdbc:postgresql://localhost:5432/aquaflow

# --- Redis (backend cache; may be replaced by an in-memory cache later) ---
REDIS_HOST=localhost
# Optional: set to false when Redis isn't running, so /actuator/health doesn't report DOWN
# MANAGEMENT_HEALTH_REDIS_ENABLED=false

# --- Auth ---
# Generate with:  openssl rand -base64 48
JWT_SECRET=
# Optional: browser origins allowed to call the API (comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Admin user (seeded on first run) ---
# Generate a password with:  openssl rand -base64 18   (no spaces around the "=")
ADMIN_EMAIL=admin@aquaflow.local
ADMIN_PASSWORD=

# --- Frontend (put in frontend/.env.local, not here) ---
# API_URL=http://localhost:8080     (server-side only; the browser never calls the API directly)

# --- AI chatbot (Week 3) ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=